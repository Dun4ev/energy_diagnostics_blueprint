{
  "$defs": {
    "AnalysisMetrics": {
      "additionalProperties": false,
      "properties": {
        "ambientC": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ambientc"
        },
        "expectedTemperatureC": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expectedtemperaturec"
        },
        "failureProbability": {
          "title": "Failureprobability",
          "type": "null"
        },
        "loadFraction": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Loadfraction"
        },
        "observedTemperatureC": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observedtemperaturec"
        },
        "residualC": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Residualc"
        },
        "slopeCPerDay": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Slopecperday"
        },
        "trendWindowHours": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Trendwindowhours"
        }
      },
      "required": [
        "observedTemperatureC",
        "expectedTemperatureC",
        "residualC",
        "loadFraction",
        "ambientC",
        "slopeCPerDay",
        "trendWindowHours",
        "failureProbability"
      ],
      "title": "AnalysisMetrics",
      "type": "object"
    },
    "AnalysisQuality": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Coverage"
        },
        "freshSources": {
          "minimum": 0,
          "title": "Freshsources",
          "type": "integer"
        },
        "issues": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "overall": {
          "enum": [
            "good",
            "partial",
            "insufficient",
            "invalid"
          ],
          "title": "Overall",
          "type": "string"
        },
        "totalSources": {
          "minimum": 0,
          "title": "Totalsources",
          "type": "integer"
        }
      },
      "required": [
        "overall",
        "freshSources",
        "totalSources",
        "coverage",
        "issues"
      ],
      "title": "AnalysisQuality",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "missingEvidence": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Missingevidence",
          "type": "array"
        },
        "status": {
          "const": "unconfirmed",
          "title": "Status",
          "type": "string"
        },
        "supportEvidenceIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Supportevidenceids",
          "type": "array"
        },
        "title": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "code",
        "title",
        "status",
        "supportEvidenceIds",
        "missingEvidence"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "MonitoringWindow": {
      "additionalProperties": false,
      "properties": {
        "isFailureDateForecast": {
          "const": false,
          "title": "Isfailuredateforecast",
          "type": "boolean"
        },
        "maxDays": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maxdays"
        },
        "minDays": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mindays"
        }
      },
      "required": [
        "minDays",
        "maxDays",
        "isFailureDateForecast"
      ],
      "title": "MonitoringWindow",
      "type": "object"
    },
    "NextAction": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "VERIFY_TELEMETRY",
            "REQUEST_THERMOGRAPHY",
            "COMPARE_PHASES_AND_LOAD",
            "ENGINEERING_REVIEW",
            "PLAN_MAINTENANCE_IF_CONFIRMED",
            "VERIFY_AFTER_ACTION",
            "CONTINUE_OBSERVATION"
          ],
          "title": "Code",
          "type": "string"
        },
        "dueWithinHours": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duewithinhours"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "requiresHumanApproval": {
          "const": true,
          "title": "Requireshumanapproval",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "reason",
        "dueWithinHours",
        "requiresHumanApproval"
      ],
      "title": "NextAction",
      "type": "object"
    },
    "Risk": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "priority": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ],
          "title": "Priority",
          "type": "string"
        },
        "probabilistic": {
          "const": false,
          "title": "Probabilistic",
          "type": "boolean"
        },
        "scaleMax": {
          "const": 10,
          "title": "Scalemax",
          "type": "integer"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        }
      },
      "required": [
        "score",
        "scaleMax",
        "priority",
        "label",
        "probabilistic"
      ],
      "title": "Risk",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "reference"
          }
        }
      },
      "then": {
        "properties": {
          "calculationOrigin": {
            "const": "presentation_illustration"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "simulation"
          }
        }
      },
      "then": {
        "properties": {
          "calculationOrigin": {
            "const": "computed"
          },
          "modelVersion": {
            "minLength": 1,
            "type": "string"
          },
          "policyVersion": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    }
  ],
  "properties": {
    "advisoryOnly": {
      "const": true,
      "title": "Advisoryonly",
      "type": "boolean"
    },
    "analysisRunId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Analysisrunid",
      "type": "string"
    },
    "asOf": {
      "format": "date-time",
      "title": "Asof",
      "type": "string"
    },
    "assetId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Assetid",
      "type": "string"
    },
    "calculationOrigin": {
      "enum": [
        "presentation_illustration",
        "computed"
      ],
      "title": "Calculationorigin",
      "type": "string"
    },
    "controlCommandsAllowed": {
      "const": false,
      "title": "Controlcommandsallowed",
      "type": "boolean"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/Hypothesis"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "inputSnapshotId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Inputsnapshotid",
      "type": "string"
    },
    "metrics": {
      "$ref": "#/$defs/AnalysisMetrics"
    },
    "mode": {
      "enum": [
        "reference",
        "simulation"
      ],
      "title": "Mode",
      "type": "string"
    },
    "modelVersion": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Modelversion"
    },
    "monitoringWindow": {
      "$ref": "#/$defs/MonitoringWindow"
    },
    "nextActions": {
      "items": {
        "$ref": "#/$defs/NextAction"
      },
      "title": "Nextactions",
      "type": "array"
    },
    "policyVersion": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Policyversion"
    },
    "quality": {
      "$ref": "#/$defs/AnalysisQuality"
    },
    "risk": {
      "$ref": "#/$defs/Risk"
    },
    "scenarioRunId": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Scenariorunid",
      "type": "string"
    },
    "schemaVersion": {
      "const": "0.1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "status": {
      "enum": [
        "normal",
        "requires_review",
        "insufficient_data"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "analysisRunId",
    "assetId",
    "scenarioRunId",
    "asOf",
    "mode",
    "status",
    "modelVersion",
    "policyVersion",
    "inputSnapshotId",
    "calculationOrigin",
    "quality",
    "metrics",
    "risk",
    "hypotheses",
    "nextActions",
    "monitoringWindow",
    "advisoryOnly",
    "controlCommandsAllowed"
  ],
  "title": "AnalysisResult",
  "type": "object"
}
